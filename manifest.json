{
  "manifest_version": 3,
  "name": "Insta Unfollowers",
  "description": "Analyze Instagram followers locally",
  "version": "1.0.0",
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["guidedWatcher.js"]
    }
  ],
  "permissions": ["sidePanel", "tabs"],
  "icons": {}
}
